	    { "@value" : "Engelse schrijver (1952-2001)" , "@language" : "nl" },
	    { "@value" : "\u0E19\u0E31\u0E01\u0E40\u0E02\u0E35\u0E22\u0E19\u0E41\u0E25\u0E30\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E32\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2D\u0E32\u0E23\u0E21\u0E13\u0E4C\u0E02\u0E31\u0E19\u0E0A\u0E32\u0E27\u0E2D\u0E31\u0E07\u0E01\u0E24\u0E29" , "@language" : "th" },
	    { "@value" : "engleski pisac i humorist" , "@language" : "bs" },
	    { "@value" : "Enskur h\u00F6fundur" , "@language" : "is" },
	    { "@value" : "\u0430\u043D\u0433\u043B\u0456\u0439\u0441\u043A\u0456 \u043F\u0456\u0441\u044C\u043C\u0435\u043D\u043D\u0456\u043A" , "@language" : "be" },
	    { "@value" : "Siliminsili buku sabra kabi d\u0254\u0263\u0254 (1952-2001)" , "@language" : "dag" },
	    { "@value" : "\u00FChteks kaiki\u0161 tetabambi\u0161p\u00E4i" , "@language" : "vep" },
	    { "@value" : "\u078D\u07A8\u0794\u07AA\u0782\u07B0\u078C\u07AC\u0783\u07A8\u0787\u07AC\u0787\u07B0" , "@language" : "dv" },
	    { "@value" : "\u0561\u0576\u0563\u056C\u056B\u0561\u0581\u056B \u0563\u0580\u0578\u0572, \u0564\u0580\u0561\u0574\u0561\u057F\u0578\u0582\u0580\u0563, \u057D\u0581\u0565\u0576\u0561\u0580\u056B\u057D\u057F, \u00AB\u0531\u057E\u057F\u0578\u057D\u057F\u0578\u057A\u0578\u057E \u0566\u0562\u0578\u057D\u0561\u0577\u0580\u057B\u056B\u056F\u056B \u0574\u056B\u057B\u0563\u0561\u056C\u0561\u056F\u057F\u056B\u056F\u0561\u056F\u0561\u0576 \u0578\u0582\u0572\u0565\u0581\u0578\u0582\u0575\u0581\u00BB \u057E\u0565\u057A\u0565\u0580\u056B \u0577\u0561\u0580\u0584" , "@language" : "hy" },
	    { "@value" : "brytyjski pisarz" , "@language" : "pl" },
	    { "@value" : "\u30A4\u30F3\u30B0\u30E9\u30F3\u30C9\u306E\u4F5C\u5BB6" , "@language" : "ja" },
	    { "@value" : "Onye edemede sayens\u1ECB sayens\u1ECB Bekee na onye \u1ECDch\u1ECB \u1ECDch\u1ECB" , "@language" : "ig" },
	    { "@value" : "\u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044C, \u0434\u0440\u0430\u043C\u0430\u0442\u0443\u0440\u0433 \u0438 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442, \u0430\u0432\u0442\u043E\u0440 \u0441\u0435\u0440\u0438\u0438 \u043A\u043D\u0438\u0433 \u00AB\u0410\u0432\u0442\u043E\u0441\u0442\u043E\u043F\u043E\u043C \u043F\u043E \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0435\u00BB" , "@language" : "ru" },
	    { "@value" : "anglick\u00FD spisovate\u013E" , "@language" : "sk" },
	    { "@value" : "\u0C07\u0C02\u0C17\u0C4D\u0C32\u0C40\u0C37\u0C41 \u0C30\u0C1A\u0C2F\u0C3F\u0C24, \u0C39\u0C3E\u0C38\u0C4D\u0C2F\u0C15\u0C3E\u0C30\u0C41\u0C21\u0C41" , "@language" : "te" },
