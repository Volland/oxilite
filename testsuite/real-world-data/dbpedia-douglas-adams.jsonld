	    { "@value" : "scriitor, dramaturg englez" , "@language" : "ro" },
	    { "@value" : "scriptor, scriptor scaenicus, et mythistoricus (1952\u20132001)" , "@language" : "la" },
	    { "@value" : "\u07CA\u07F2\u07EC\u07DC\u07ED\u07CC\u07EC\u07DF\u07CB\u07EC \u07DB\u07D3\u07CD\u07E6\u07DF\u07CA \u07DE\u07CE\u07F2\u07EC\u07D8\u07D0\u07EC\u07D5\u07CD\u07F0 \u07DF\u07D0\u07F2\u07DE\u07CF \u07DE\u07CA\u07F2\u07EC" , "@language" : "nqo" },
	    { "@value" : "\u0D89\u0D82\u0D9C\u0DCA\u200D\u0DBB\u0DD3\u0DC3\u0DD2 \u0D9A\u0DC0\u0DD2\u0DBA\u0DD9\u0D9A\u0DCA" , "@language" : "si" },
	    { "@value" : "angle\u0161ki pisatelj, humorist in dramatik (1952\u20132001)" , "@language" : "sl" },
	    { "@value" : "\u0643\u0627\u062A\u0628 \u0646\u06AD\u0644\u064A\u0632\u064A \u062F\u064A\u0627\u0644 \u0644\u062E\u064A\u0627\u0644 \u0644\u0639\u0644\u0645\u064A \u0648 \u0644\u0641\u0643\u0627\u0647\u0629" , "@language" : "ary" },
