	    { "@value" : "taga-Inglatera na manunulat at tagapagpatawa" , "@language" : "tl" },
	    { "@value" : "\u05E1\u05D5\u05E4\u05E8 \u05D5\u05D4\u05D5\u05DE\u05D5\u05E8\u05D9\u05E1\u05D8\u05DF \u05D1\u05E8\u05D9\u05D8\u05D9" , "@language" : "iw" },
	    { "@value" : "Ingliz yozuvchisi, dramaturg va ssenariynavis, \u201CHitchikerning Galaktikaga qo\u02BBllanma\u201D turkum kitoblari muallifi." , "@language" : "uz" },
	    { "@value" : "escritor y humorista ingl\u00E9s" , "@language" : "ast" },
	    { "@value" : "nh\u00E0 v\u0103n v\u00E0 nh\u00E0 so\u1EA1n h\u00E0i k\u1ECBch ng\u01B0\u1EDDi Anh (1952-2001)" , "@language" : "vi" },
	    { "@value" : "Engelse skrywer en humoris (1952\u20132001)" , "@language" : "af" },
	    { "@value" : "angl\u0173 ra\u0161ytojas" , "@language" : "lt" },
	    { "@value" : "angol \u00EDr\u00F3 \u00E9s humorista (1952\u20132001)" , "@language" : "hu" },
	    { "@value" : "\u0C87\u0C82\u0C97\u0CCD\u0CB2\u0CBF\u0CB7\u0CCD \u0CAD\u0CBE\u0CB7\u0CC6\u0CAF \u0CAC\u0CB0\u0CB9\u0C97\u0CBE\u0CB0 \u0CB9\u0CBE\u0C97\u0CC2 \u0CB9\u0CBE\u0CB8\u0CCD\u0CAF \u0CB2\u0CC7\u0C96\u0C95" , "@language" : "kn" },
	    { "@value" : "sgr\u00ECobhadair Sasannach" , "@language" : "gd" },
	    { "@value" : "\u0130ngiliz bilim kurgu ve mizah yazar\u0131" , "@language" : "tr" },
	    { "@value" : "ang\u013Cu zin\u0101tnisk\u0101s fantastikas rakstnieks un humorists" , "@language" : "lv" },
	    { "@value" : "\u10D8\u10DC\u10D2\u10DA\u10D8\u10E1\u10D4\u10DA\u10D8 \u10DB\u10EC\u10D4\u10E0\u10D0\u10DA\u10D8 \u10D3\u10D0 \u10D8\u10E3\u10DB\u10DD\u10E0\u10D8\u10E1\u10E2\u10D8" , "@language" : "ka" },
