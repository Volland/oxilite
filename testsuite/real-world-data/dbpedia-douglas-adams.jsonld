	    { "@value" : "brittil\u00E4inen kirjailija ja humoristi" , "@language" : "fi" },
	    { "@value" : "\u0430\u043D\u0433\u043B\u0438\u0441\u043A\u0438 \u043F\u0438\u0441\u0430\u0442\u0435\u043B \u0438 \u0445\u0443\u043C\u043E\u0440\u0438\u0441\u0442" , "@language" : "mk" },
