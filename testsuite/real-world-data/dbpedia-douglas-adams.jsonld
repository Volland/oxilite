	    { "@value" : "forfattar" , "@language" : "nn" },
	    { "@value" : "\u0905\u0919\u094D\u0917\u094D\u0930\u0947\u091C\u0940 \u0932\u0947\u0916\u0915 \u0930 \u0935\u094D\u092F\u0919\u094D\u0917\u094D\u092F\u0915\u093E\u0930" , "@language" : "ne" },
