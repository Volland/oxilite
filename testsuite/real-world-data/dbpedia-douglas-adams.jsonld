      "description": [ { "@value" : "mwandishi Mwingereza" , "@language" : "sw" },
	    { "@value" : "escritor e comediante brit\u00E2nico (1952\u20132001)" , "@language" : "pt" },
	    { "@value" : "\u0643\u0627\u062A\u0628 \u0625\u0646\u062C\u0644\u064A\u0632\u064A \u0641\u0643\u0627\u0647\u064A" , "@language" : "ar" },
	    { "@value" : "idazle eta umorista britaniarra" , "@language" : "eu" },
	    { "@value" : "scr\u00EDbhneoir Sasanach (1952\u20132001)" , "@language" : "ga" },
	    { "@value" : "Eng-kok b\u00FBn-ha\u030Dk-ka, chh\u00F9-b\u012B chok-ka (1952\u20132001)" , "@language" : "nan" },
	    { "@value" : "brittisk f\u00F6rfattare (1952\u20132001)" , "@language" : "sv" },
	    { "@value" : "\u0431\u0440\u0438\u0442\u0430\u043D\u0441\u044C\u043A\u0438\u0439 \u043A\u043E\u043C\u0456\u0447\u043D\u0438\u0439 \u0440\u0430\u0434\u0456\u043E\u0434\u0440\u0430\u043C\u0430\u0442\u0443\u0440\u0433, \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0438\u043A" , "@language" : "uk" },
	    { "@value" : "britischer Science-Fiction-Autor und Humorist" , "@language" : "de" },
	    { "@value" : "scritore brit\u00E0nego" , "@language" : "vec" },
	    { "@value" : "\u0A85\u0A82\u0A97\u0ACD\u0AB0\u0AC7\u0A9C\u0AC0 \u0AB2\u0AC7\u0A96\u0A95 \u0A85\u0AA8\u0AC7 \u0AB9\u0ABE\u0AB8\u0ACD\u0AAF\u0A95\u0ABE\u0AB0" , "@language" : "gu" },
	    { "@value" : "britsk\u00FD spisovatel, humorista a dramatik" , "@language" : "cs" },
	    { "@value" : "\u0B86\u0B99\u0BCD\u0B95\u0BBF\u0BB2 \u0B8E\u0BB4\u0BC1\u0BA4\u0BCD\u0BA4\u0BBE\u0BB3\u0BB0\u0BCD \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA8\u0B95\u0BC8\u0B9A\u0BCD\u0B9A\u0BC1\u0BB5\u0BC8\u0BAF\u0BBE\u0BB3\u0BB0\u0BCD" , "@language" : "ta" },
	    { "@value" : "angla a\u016Dtoro de sciencfikcio-romanoj kaj humoristo" , "@language" : "eo" },
	    { "@value" : "\u0D2C\u0D4D\u0D30\u0D3F\u0D1F\u0D4D\u0D1F\u0D40\u0D37\u0D4D \u0D0E\u0D34\u0D41\u0D24\u0D4D\u0D24\u0D41\u0D15\u0D3E\u0D30\u0D28\u0D41\u0D02 \u0D39\u0D3E\u0D38\u0D4D\u0D2F\u0D38\u0D3E\u0D39\u0D3F\u0D24\u0D4D\u0D2F\u0D3E\u0D15\u0D3E\u0D30\u0D28\u0D41\u0D02" , "@language" : "ml" },
	    { "@value" : "\u0641\u06CC\u0644\u0645\u0646\u0627\u0645\u0647\u200C\u0646\u0648\u06CC\u0633 \u0648 \u0646\u0648\u06CC\u0633\u0646\u062F\u0647 \u0628\u0631\u06CC\u062A\u0627\u0646\u06CC\u0627\u06CC\u06CC" , "@language" : "fa" },
	    { "@value" : "\u0905\u0902\u0917\u094D\u0930\u0947\u091C\u0940 \u0932\u0947\u0916\u0915" , "@language" : "hi" },
	    { "@value" : "English write who dey write or act in funny way bi" , "@language" : "gpe" },
	    { "@value" : "\u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438 \u043F\u0438\u0441\u0430\u0442\u0435\u043B \u0438 \u0445\u0443\u043C\u043E\u0440\u0438\u0441\u0442" , "@language" : "bg" },
	    { "@value" : "escriptor angl\u00E8s" , "@language" : "ca" },
	    { "@value" : "\u1C64\u1C5D\u1C5E\u1C64\u1C65 \u1C69\u1C6D\u1C66\u1C5F\u1C79\u1C68 \u1C65\u1C5F\u1C6C\u1C6E\u1C65 \u1C5A\u1C71\u1C5A\u1C5E\u1C64\u1C6D\u1C5F\u1C79 \u1C5F\u1C68 \u1C5E\u1C5F\u1C78\u1C6B\u1C5F \u1C68\u1C69\u1C65\u1C64\u1C60\u1C5F" , "@language" : "sat" },
	    { "@value" : "\u0438\u043D\u0433\u043B\u0438\u0437 \u044F\u0499\u044B\u0443\u0441\u044B\u04BB\u044B, \u0434\u0440\u0430\u043C\u0430\u0442\u0443\u0440\u0433 \u04BB\u04D9\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442, \u044E\u043C\u043E\u0440\u0438\u0441\u0442\u0438\u043A \u0444\u0430\u043D\u0442\u0430\u0441\u0442\u0438\u043A \u04D9\u04AB\u04D9\u0440\u0499\u04D9\u0440 \u0430\u0432\u0442\u043E\u0440\u044B" , "@language" : "ba" },
	    { "@value" : "a englischer Science-Fiction-Schriftsteller" , "@language" : "bar" },
	    { "@value" : "\u0386\u03B3\u03B3\u03BB\u03BF\u03C2 \u03C3\u03C5\u03B3\u03B3\u03C1\u03B1\u03C6\u03AD\u03B1\u03C2" , "@language" : "el" },
	    { "@value" : "\u0987\u0982\u09B0\u09C7\u099C \u0995\u09B2\u09CD\u09AA\u09AC\u09BF\u099C\u09CD\u099E\u09BE\u09A8 \u09B2\u09C7\u0996\u0995 \u0993 \u0995\u09CC\u09A4\u09C1\u0995\u09AC\u09BF\u09A6" , "@language" : "bn" },
	    { "@value" : "englischer Schriftsteller" , "@language" : "nds" },
	    { "@value" : "Marubucin Ingilishi kuma \u0257an \u0257an adam (1952-2001)" , "@language" : "ha" },
	    { "@value" : "\u0438\u043D\u0433\u043B\u0438\u0437 \u044F\u0437\u0443\u0447\u044B\u0441\u044B, \u0434\u0440\u0430\u043C\u0430\u0442\u0443\u0440\u0433 \u04BB\u04D9\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442" , "@language" : "tt" },
	    { "@value" : "\u092C\u094D\u0930\u093F\u091F\u093F\u0936 \u0932\u0947\u0916\u0915 \u0935 \u0928\u093E\u091F\u0915\u0915\u093E\u0930" , "@language" : "mr" },
	    { "@value" : "engelsk forfatter (1952-2001)" , "@language" : "da" },
	    { "@value" : "scrittore e umorista britannico (1952\u20132001)" , "@language" : "it" },
	    { "@value" : "\u0435\u043D\u0433\u043B\u0435\u0441\u043A\u0438 \u043F\u0438\u0441\u0430\u0446 \u0438 \u0445\u0443\u043C\u043E\u0440\u0438\u0441\u0442\u0430" , "@language" : "sr" },
	    { "@value" : "Muwandisi wa fiction" , "@language" : "lg" },
	    { "@value" : "\u0A05\u0A70\u0A17\u0A30\u0A47\u0A1C\u0A3C\u0A40 \u0A32\u0A47\u0A16\u0A15" , "@language" : "pa" },
