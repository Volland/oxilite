{
  "name": "@oxilite/node",
  "version": "0.2.1",
  "description": "oxilite for Node.js: an Oxigraph-compatible SPARQL 1.1 and openCypher store on SQLite",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "oxilite.*-*.node"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "tsc -p .",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results.json; node scripts/check-results.mjs test-results.json"
  },
  "dependencies": {
    "@oxilite/common": "0.2.1"
  },
  "devDependencies": {
    "@rdfjs/data-model": "^2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Volland/oxilite.git",
    "directory": "bindings/node"
  },
  "homepage": "https://oxilitedb.com",
  "bugs": "https://github.com/Volland/oxilite/issues",
  "author": "Volodymyr Pavlyshyn",
  "keywords": [
    "rdf",
    "sparql",
    "cypher",
    "opencypher",
    "property-graph",
    "sqlite",
    "oxigraph",
    "rdfjs",
    "knowledge-graph"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
